ENVIRONMENT=development
APP_NAME=NEXUS Backend
API_PREFIX=/api
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Supabase project configuration. Do not commit real credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
DATABASE_URL=

# JWT validation. Prefer JWKS for asymmetric Supabase signing keys when available.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated
JWT_ALGORITHMS=RS256,ES256,HS256

LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
ALLOW_DEV_AUTH_FALLBACK=false
